{
  "name": "udie-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Urban Disruption Intelligence Engine backend",
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run build && node --test test/*.test.cjs",
    "db:migrate": "bash ./scripts/migrate_all.sh",
    "migration:up": "bash ./scripts/migrate_all.sh",
    "test:risk": "npm run build && node --test test/risk.service.test.cjs",
    "validate:rebuild": "bash ./scripts/validate_rebuild.sh",
    "validate:plan": "bash ./scripts/check_risk_query_plan.sh",
    "verify:architecture": "bash ./scripts/verify_architecture.sh",
    "bench:memory-grid": "ts-node benchmarks/memory_grid_bench.ts",
    "bench:intelligence": "ts-node benchmarks/intelligence_eval.ts",
    "test:architecture": "node --test test/hotspot-clustering.test.cjs test/forecast-stability.test.cjs test/density-amplification.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-ws": "^10.4.22",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/websockets": "^10.4.22",
    "@types/compression": "^1.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "h3-js": "^4.1.0",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.11",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.7.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
